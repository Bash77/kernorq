# Gemini API (recommended local path). Get a key at https://aistudio.google.com/apikey
# Never commit the real key. Keep this file as a template only.
GOOGLE_API_KEY=

# Optional Vertex AI fallback (used ONLY when GOOGLE_API_KEY is unset).
# Requires billing attached to the project.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Planner model — hackathon requires Gemini 3.5 or newer
MODEL_NAME=gemini-3.5-flash

# Voice models (optional overrides; defaults are compliant)
KERNORQ_TRANSCRIBE_MODEL=gemini-3.5-flash
KERNORQ_TTS_MODEL=gemini-3.1-flash-tts-preview
KERNORQ_VOICE_NAME=Kore

# Demo fallback: run deterministic plan when Gemini is unreachable
GEMINI_FALLBACK=true
